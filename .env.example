# StockLens AI local development environment.
# Copy this file to .env and adjust local credentials if needed.

NODE_ENV=development

# Project-owned PostgreSQL container.
# Uses docker/postgres/Dockerfile to persist pgvector in the image.
POSTGRES_DB=stocklens_ai
POSTGRES_USER=stocklens
POSTGRES_PASSWORD=stocklens-dev-password
POSTGRES_PORT=15433

# Use localhost when running API/worker directly on the host.
DATABASE_URL=postgresql://stocklens:stocklens-dev-password@localhost:15433/stocklens_ai?schema=public

# Use the service name when running API/worker inside this Docker Compose network.
DATABASE_URL_DOCKER=postgresql://stocklens:stocklens-dev-password@postgres:5432/stocklens_ai?schema=public

# Redis is managed by compose.yaml.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_URL_DOCKER=redis://redis:6379

# Local S3-compatible object storage for uploaded PDFs.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=stocklens
MINIO_ROOT_PASSWORD=stocklens-dev-password
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_REGION=ap-northeast-1
S3_BUCKET=stocklens-dev
S3_ACCESS_KEY_ID=stocklens
S3_SECRET_ACCESS_KEY=stocklens-dev-password
S3_FORCE_PATH_STYLE=true

# Application defaults reserved for Phase 1.
WEB_PORT=3000
API_PORT=3001
WORKER_CONCURRENCY=2

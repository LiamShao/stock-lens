# StockLens AI local development environment.
# Copy this file to .env and adjust local credentials if needed.

NODE_ENV=development

# Project-owned PostgreSQL container.
# Uses docker/postgres/Dockerfile to persist pgvector in the image.
POSTGRES_DB=stocklens_ai
POSTGRES_USER=stocklens
POSTGRES_PASSWORD=stocklens-dev-password
POSTGRES_PORT=15433

# Use localhost when running API/worker directly on the host.
DATABASE_URL=postgresql://stocklens:stocklens-dev-password@localhost:15433/stocklens_ai?schema=public

# Use the service name when running API/worker inside this Docker Compose network.
DATABASE_URL_DOCKER=postgresql://stocklens:stocklens-dev-password@postgres:5432/stocklens_ai?schema=public

# Redis is used by API cleanup publishing and worker dispatch/retry.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
ALLOW_JOB_RERUN=false
JOB_OPERATOR_SECRET=stocklens-local-job-operator-secret
ALLOW_PROMPT_ACTIVATION=false
REDIS_URL_DOCKER=redis://redis:6379

# Local S3-compatible private object storage for uploaded PDFs.
# Create S3_BUCKET once after `docker compose up`; see docker/README.md.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=stocklens
MINIO_ROOT_PASSWORD=stocklens-dev-password
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_REGION=ap-northeast-1
S3_BUCKET=stocklens-dev
S3_ACCESS_KEY_ID=stocklens
S3_SECRET_ACCESS_KEY=stocklens-dev-password
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_IN_SECONDS=300

# Application runtime.
WEB_PORT=3000
API_PORT=3001
WORKER_CONCURRENCY=2
# Browser-visible API base URL. It is not a secret and must include /api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Phase 4 structured extraction. The model is intentionally not hard-coded.
# Keep the API key in the worker environment or Secrets Manager only.
OPENAI_API_KEY=
OPENAI_MODEL=
# A live evaluation makes one paid Responses API call and is never enabled in CI.
ALLOW_OPENAI_LIVE_EVALUATION=false
# Optional until Phase 6 embedding is enabled.
OPENAI_EMBEDDING_MODEL=

# Authentication. Replace the secret in every non-local environment.
ACCESS_TOKEN_SECRET=stocklens-local-access-token-secret-change-me
ACCESS_TOKEN_ISSUER=stocklens-api
ACCESS_TOKEN_AUDIENCE=stocklens-web
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
CORS_ORIGIN=http://localhost:3000

# Local demo account. The provisioning command is explicit and never runs on API startup.
DEMO_USER_EMAIL=demo@stocklens.local
DEMO_USER_PASSWORD=stocklens-demo-password
DEMO_USER_DISPLAY_NAME=StockLens Demo
ALLOW_DEMO_USER_PROVISIONING=false

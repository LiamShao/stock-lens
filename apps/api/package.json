{
  "name": "@stocklens/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "demo:user:provision": "nest start --entryFile provision-demo-user",
    "dev": "nest start --watch",
    "lint": "eslint src test --max-warnings=0",
    "start": "node dist/main.js",
    "test": "jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.3.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "^6.19.0",
    "@stocklens/shared": "workspace:*",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.28",
    "@stocklens/config": "workspace:*",
    "@stocklens/eslint-config": "workspace:*",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}

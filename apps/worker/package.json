{
  "name": "@stocklens/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "job:operations": "tsx src/job-operations.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/main.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@stocklens/object-storage": "workspace:*",
    "@stocklens/shared": "workspace:*",
    "bullmq": "^5.80.2",
    "dotenv": "^17.4.2",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@stocklens/config": "workspace:*",
    "@stocklens/eslint-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
